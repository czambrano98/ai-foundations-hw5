# Example environment for Campus Customs. Do NOT commit a real .env.
# The agents call gpt-6-luna through Portkey's OpenAI-compatible gateway, so the
# only required value is your Portkey API key. Set these in your shell before
# starting the backend.
#
#   macOS / Linux:   export PORTKEY_API_KEY=...
#   Windows (PowerShell):   $env:PORTKEY_API_KEY = "..."

# Required: your Portkey API key (routes to gpt-6-luna)
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional Portkey routing, only if your setup needs them
# PORTKEY_VIRTUAL_KEY=
# PORTKEY_PROVIDER=
# PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Optional overrides (defaults shown)
# CAMPUS_MODEL=gpt-6-luna
# CAMPUS_MAX_REQUESTS=60
# CAMPUS_MAX_DELEGATION_DEPTH=3
# CAMPUS_MAX_DELEGATIONS=8
